# URL base de la API (debe incluir /api si el backend sirve las rutas bajo /api)
# Ejemplo: http://localhost:8000/api
VITE_API_BASE_URL=/api

# Debe coincidir con CODIGO_CORRELATIVO_MIN_DIGITS del backend (fallback si /system/codigos no responde)
VITE_CODIGO_CORRELATIVO_MIN_DIGITS=3
VITE_CODIGO_CORRELATIVO_MAX_DIGITS=10

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_REALTIME_DEBUG=false